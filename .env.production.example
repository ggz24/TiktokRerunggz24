# Copy to .env.production and fill on the server. Never commit the filled file.
DOMAIN=example.invalid
APP_USERNAME=
APP_PASSWORD=
SESSION_SECRET=
ACCOUNT_ENCRYPTION_KEY=
INTERNAL_API_TOKEN=
POSTGRES_PASSWORD=
MAX_CONCURRENT_LIVE=
RAPIDAPI_KEY=
EULER_STREAM_API_KEY=
TIKTOK_STUDIO_VERSION=1.36.6
TIKTOK_STUDIO_DEVICE_ID=0
TIKTOK_STUDIO_INSTALL_ID=0
TIKTOK_LIVE_CATEGORY_ID=0
